@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container(apiGateway, "API Gateway", "HTTP / REST", "Входная точка")
Container(eventBroker, "Event Broker", "Kafka / RabbitMQ", "События телеметрии")
ContainerDb(telemetryDb, "Telemetry DB", "TimescaleDB / PostgreSQL", "История показаний")

Container_Boundary(telemetryService, "Telemetry Service") {
    Component(telemetryController, "TelemetryController", "REST Controller", "Получение истории показаний")
    Component(telemetryEventHandler, "TelemetryEventHandler", "Event Handler", "Принимает события телеметрии")
    Component(telemetryNormalizer, "TelemetryNormalizer", "Service", "Приводит показания к единому формату")
    Component(telemetryRepository, "TelemetryRepository", "Repository", "Сохраняет и читает телеметрию")
}

Rel(apiGateway, telemetryController, "Запрашивает историю", "REST")
Rel(telemetryController, telemetryRepository, "Читает данные")
Rel(eventBroker, telemetryEventHandler, "TemperatureChanged / DeviceMetricReceived", "Events")
Rel(telemetryEventHandler, telemetryNormalizer, "Нормализует данные")
Rel(telemetryNormalizer, telemetryRepository, "Сохраняет показания")
Rel(telemetryRepository, telemetryDb, "Читает и пишет", "SQL")

@enduml